-- ฟังก์ชันดึงวัตถุตัวละคร / รถ
local function GetTargetRoot()
    local char = LocalPlayer.Character
    if not char then return nil end
    
    -- หากนั่งขับรถอยู่ ให้ใช้ PrimaryPart ของรถ เพื่อวาปรถไปด้วย
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.SeatPart then
        local vehicle = humanoid.SeatPart.Parent
        while vehicle and not vehicle:IsA("Model") do
            vehicle = vehicle.Parent
        end
        if vehicle and vehicle.PrimaryPart then
            return vehicle.PrimaryPart, vehicle
        end
    end
    
    return char:FindFirstChild("HumanoidRootPart"), char
end

-- ฟังก์ชันย้ายตำแหน่ง (Teleport)
local function TeleportTo(targetCFrame)
    local root = GetTargetRoot()
    if root then
        root.CFrame = targetCFrame + Vector3.new(0, 3, 0)
    end
end

-- ฟังก์ชันค้นหาจุดหมุดเป้าหมายในเกม (Pickup / Drop-off Target)
local function GetJobDestination()
    -- 1. ค้นหาจาก Beam หรือ Highlight ที่เกมสร้างขึ้น
    for _, v in pairs(Workspace:GetDescendants()) do
        if (v:IsA("Beam") or v:IsA("SelectionBox")) and v.Parent and v.Parent:IsA("BasePart") then
            if v.Visible then
                return v.Parent.CFrame
            end
        end
    end
    
    -- 2. ค้นหาจาก BillboardGui / Marker บนหัว NPC หรือสถานที่ส่ง
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BillboardGui") and v.Enabled then
            local p = v.Parent
            if p and p:IsA("BasePart") then
                return p.CFrame
            end
        end
    end
    
    return nil
end

-- ฟังก์ชันคลิกปุ่มอัตโนมัติ (รองรับ UI ในโทรศัพท์)
local function AutoClickJobButtons()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end

    for _, gui in pairs(playerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled then
            for _, btn in pairs(gui:GetDescendants()) do
                if btn:IsA("TextButton") or btn:IsA("ImageButton") then
                    if btn.Visible then
                        local txt = string.lower(btn:IsA("TextButton") and btn.Text or btn.Name)
                        -- คำที่พบบ่อยในแอป QuickRider: รับงาน, รับลูกค้า, ส่งลูกค้า, ตกลง, Confirm
                        if string.find(txt, "accept") or string.find(txt, "confirm") or string.find(txt, "pick") or string.find(txt, "drop") or string.find(txt, "รับ") or string.find(txt, "ส่ง") or string.find(txt, "slide") then
                            pcall(function()
                                for _, event in pairs({"MouseButton1Click", "Activated"}) do
                                    for _, conn in pairs(getconnections(btn[event])) do
                                        conn:Fire()
                                    end
                                end
                            end)
                        end
                    end
                end
            end
        end
    end
end

-- ลูปทำงาน Auto Farm
task.spawn(function()
    while true do
        if AutoFarm then
            pcall(function()
                -- กดรับงาน/กดปุ่มในมือถืออัตโนมัติ
                AutoClickJobButtons()
                
                -- ค้นหาจุดเป้าหมาย (จุดรับ NPC หรือ จุดส่ง)
                local destCFrame = GetJobDestination()
                if destCFrame then
                    TeleportTo(destCFrame)
                end
            end)
        end
        task.wait(1) -- ระยะเวลาวนลูป (1 วินาที)
    end
end)

