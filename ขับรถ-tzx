-- ฟังก์ชันหาตำแหน่งตัวละครหรือรถที่ขับอยู่
local function GetRootPart()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.SeatPart then
        local vehicle = hum.SeatPart.Parent
        while vehicle and not vehicle:IsA("Model") do
            vehicle = vehicle.Parent
        end
        if vehicle then
            return vehicle.PrimaryPart or hum.SeatPart
        end
    end
    return char:FindFirstChild("HumanoidRootPart")
end

-- ฟังก์ชันย้ายตำแหน่ง (Teleport)
local function TeleportTo(cframe)
    local root = GetRootPart()
    if root then
        root.CFrame = cframe + Vector3.new(0, 3, 0)
    end
end

-- ฟังก์ชันดึงพิกัดจากเป้าหมายหมุด/Beam/NPC ในเกม
local function FindDestination()
    -- 1. ค้นหาหมุดบอกตำแหน่ง (Beam / Highlight)
    for _, obj in pairs(Workspace:GetDescendants()) do
        if (obj:IsA("Beam") or obj:IsA("SelectionBox") or obj:IsA("CylinderHandleAdornment")) then
            if obj.Visible and obj.Parent and obj.Parent:IsA("BasePart") then
                return obj.Parent.CFrame
            end
        end
    end
    
    -- 2. ค้นหาจากป้ายชื่อจุดรับ-ส่ง NPC (BillboardGui)
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BillboardGui") and obj.Enabled then
            if obj.Parent and obj.Parent:IsA("BasePart") then
                return obj.Parent.CFrame
            end
        end
    end
    
    return nil
end

-- ฟังก์ชันกดปุ่มสไลด์/ปุ่มยืนยันในโทรศัพท์อัตโนมัติ
local function TriggerPhoneButtons()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end

    for _, gui in pairs(playerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled then
            for _, element in pairs(gui:GetDescendants()) do
                -- ตรวจหาปุ่ม TextButton / ImageButton / Frame สไลด์
                if element:IsA("TextButton") or element:IsA("ImageButton") or element:IsA("Frame") then
                    local name = string.lower(element.Name)
                    local text = element:IsA("TextButton") and string.lower(element.Text) or ""
                    
                    -- ตรวจหาคำว่า slide, accept, confirm, pick, drop, order
                    if string.find(name, "slide") or string.find(text, "slide") or 
                       string.find(name, "accept") or string.find(text, "accept") or
                       string.find(text, "confirm") or string.find(name, "confirm") then
                        
                        pcall(function()
                            -- จำลองการคลิกแบบกดค้าง/สไลด์ผ่าน VirtualInputManager
                            local pos = element.AbsolutePosition
                            local size = element.AbsoluteSize
                            local startX = pos.X + 10
                            local startY = pos.Y + (size.Y / 2)
                            local endX = pos.X + size.X - 10
                            
                            -- กดลงแล้วลากไปทางขวา (Simulate Touch Drag)
                            VirtualInputManager:SendTouchEvent(0, 0, startX, startY)
                            task.wait(0.05)
                            VirtualInputManager:SendTouchEvent(0, 1, endX, startY)
                            task.wait(0.05)
                            VirtualInputManager:SendTouchEvent(0, 2, endX, startY)
                            
                            -- รัน Event ปกติสำรองไว้
                            if element:IsA("GuiButton") then
                                for _, conn in pairs(getconnections(element.MouseButton1Click)) do conn:Fire() end
                                for _, conn in pairs(getconnections(element.Activated)) do conn:Fire() end
                            end
                        end)
                    end
                end
            end
        end
    end
end

-- ลูปทำงาน Auto Farm หลัก
task.spawn(function()
    while true do
        if AutoFarm then
            pcall(function()
                -- 1. กดรับงานในโทรศัพท์
                TriggerPhoneButtons()
                
                -- 2. วาปไปยังจุดหมาย (จุดรับลูกค้า / จุดส่ง)
                local dest = FindDestination()
                if dest then
                    TeleportTo(dest)
                end
            end)
        end
        task.wait(0.8) -- ปรับเวลาสแกนหน่วงเพื่อป้องกันการโดนเตะ
    end
end)

