local tabs = {}
local function createTab(tabName, iconText)
    local Page = Instance.new("ScrollingFrame")
    Page.Name = tabName .. "_Page"
    Page.Size = UDim2.new(1, -6, 1, 0)
    Page.Position = UDim2.new(0, 0, 0, 0)
    Page.BackgroundTransparency = 1
    Page.BorderSizePixel = 0
    Page.ScrollBarThickness = 3
    Page.ScrollBarImageColor3 = Color3.fromRGB(255, 35, 35)
    Page.Visible = false
    Page.Parent = ContentHolder

    local Layout = Instance.new("UIListLayout")
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.Padding = UDim.new(0, 6)
    Layout.Parent = Page

    Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Page.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y + 15)
    end)

    local TabBtn = Instance.new("TextButton")
    TabBtn.Name = tabName .. "_TabBtn"
    TabBtn.Size = UDim2.new(1, 0, 0, 36)
    TabBtn.BackgroundColor3 = Color3.fromRGB(15, 20, 28)
    TabBtn.BorderSizePixel = 0
    TabBtn.Font = Enum.Font.GothamMedium
    TabBtn.Text = (iconText or "") .. " " .. tabName
    TabBtn.TextColor3 = Color3.fromRGB(170, 180, 195)
    TabBtn.TextSize = 12
    TabBtn.TextXAlignment = Enum.TextXAlignment.Left
    TabBtn.Parent = TabButtonHolder

    local BtnPadding = Instance.new("UIPadding")
    BtnPadding.PaddingLeft = UDim.new(0, 10)
    BtnPadding.Parent = TabBtn

    local TabCorner = Instance.new("UICorner")
    TabCorner.CornerRadius = UDim.new(0, 6)
    TabCorner.Parent = TabBtn

    local function selectThisTab()
        for _, t in pairs(tabs) do
            t.Page.Visible = false
            t.Button.BackgroundColor3 = Color3.fromRGB(15, 20, 28)
            t.Button.TextColor3 = Color3.fromRGB(170, 180, 195)
        end
        Page.Visible = true
        TabBtn.BackgroundColor3 = Color3.fromRGB(35, 110, 240)
        TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end

    TabBtn.MouseButton1Click:Connect(selectThisTab)

    local tabObj = { Page = Page, Button = TabBtn, Layout = Layout }
    table.insert(tabs, tabObj)

    if #tabs == 1 then selectThisTab() end

    local tabFunctions = {}

    function tabFunctions:CreateSection(title)
        local Sec = Instance.new("Frame")
        Sec.Size = UDim2.new(1, -6, 0, 26)
        Sec.BackgroundTransparency = 1
        Sec.Parent = Page

        local Label = Instance.new("TextLabel")
        Label.Size = UDim2.new(1, 0, 1, 0)
        Label.BackgroundTransparency = 1
        Label.Font = Enum.Font.GothamBold
        Label.Text = title
        Label.TextColor3 = Color3.fromRGB(240, 100, 100)
        Label.TextSize = 12
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.Parent = Sec
    end

    function tabFunctions:CreateButton(name, callback)
        local Btn = Instance.new("TextButton")
        Btn.Size = UDim2.new(1, -6, 0, 32)
        Btn.BackgroundColor3 = Color3.fromRGB(22, 28, 38)
        Btn.BorderSizePixel = 0
        Btn.Font = Enum.Font.GothamMedium
        Btn.Text = name
        Btn.TextColor3 = Color3.fromRGB(230, 230, 230)
        Btn.TextSize = 12
        Btn.Parent = Page

        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 6)
        c.Parent = Btn

        Btn.MouseButton1Click:Connect(function()
            pcall(callback)
        end)
    end

    function tabFunctions:CreateToggle(name, defaultVal, callback)
        local state = defaultVal or false

        local ToggleFrame = Instance.new("TextButton")
        ToggleFrame.Size = UDim2.new(1, -6, 0, 34)
        ToggleFrame.BackgroundColor3 = Color3.fromRGB(22, 28, 38)
        ToggleFrame.BorderSizePixel = 0
        ToggleFrame.Text = ""
        ToggleFrame.Parent = Page

        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 6)
        c.Parent = ToggleFrame

        local Txt = Instance.new("TextLabel")
        Txt.Size = UDim2.new(1, -60, 1, 0)
        Txt.Position = UDim2.new(0, 10, 0, 0)
        Txt.BackgroundTransparency = 1
        Txt.Font = Enum.Font.GothamMedium
        Txt.Text = name
        Txt.TextColor3 = Color3.fromRGB(230, 230, 230)
        Txt.TextSize = 12
        Txt.TextXAlignment = Enum.TextXAlignment.Left
        Txt.Parent = ToggleFrame

        local Switch = Instance.new("Frame")
        Switch.Size = UDim2.new(0, 42, 0, 20)
        Switch.Position = UDim2.new(1, -48, 0.5, -10)
        Switch.BackgroundColor3 = state and Color3.fromRGB(35, 110, 240) or Color3.fromRGB(45, 50, 60)
        Switch.BorderSizePixel = 0
        Switch.Parent = ToggleFrame

        local sc = Instance.new("UICorner")
        sc.CornerRadius = UDim.new(1, 0)
        sc.Parent = Switch

        local Dot = Instance.new("Frame")
        Dot.Size = UDim2.new(0, 16, 0, 16)
        Dot.Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
        Dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        Dot.BorderSizePixel = 0
        Dot.Parent = Switch

        local dc = Instance.new("UICorner")
        dc.CornerRadius = UDim.new(1, 0)
        dc.Parent = Dot

        ToggleFrame.MouseButton1Click:Connect(function()
            state = not state
            if state then
                Switch.BackgroundColor3 = Color3.fromRGB(35, 110, 240)
                Dot.Position = UDim2.new(1, -18, 0.5, -8)
            else
                Switch.BackgroundColor3 = Color3.fromRGB(45, 50, 60)
                Dot.Position = UDim2.new(0, 2, 0.5, -8)
            end
            pcall(callback, state)
        end)
    end

    function tabFunctions:CreateSlider(name, min, max, defaultVal, callback)
        local value = defaultVal or min

        local SliderFrame = Instance.new("Frame")
        SliderFrame.Size = UDim2.new(1, -6, 0, 44)
        SliderFrame.BackgroundColor3 = Color3.fromRGB(22, 28, 38)
        SliderFrame.BorderSizePixel = 0
        SliderFrame.Parent = Page

        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 6)
        c.Parent = SliderFrame

        local Title = Instance.new("TextLabel")
        Title.Size = UDim2.new(0.7, 0, 0, 20)
        Title.Position = UDim2.new(0, 10, 0, 4)
        Title.BackgroundTransparency = 1
        Title.Font = Enum.Font.GothamMedium
        Title.Text = name
        Title.TextColor3 = Color3.fromRGB(230, 230, 230)
        Title.TextSize = 11
        Title.TextXAlignment = Enum.TextXAlignment.Left
        Title.Parent = SliderFrame

        local ValLabel = Instance.new("TextLabel")
        ValLabel.Size = UDim2.new(0.28, 0, 0, 20)
        ValLabel.Position = UDim2.new(0.7, 0, 0, 4)
        ValLabel.BackgroundTransparency = 1
        ValLabel.Font = Enum.Font.GothamBold
        ValLabel.Text = tostring(value)
        ValLabel.TextColor3 = Color3.fromRGB(80, 160, 255)
        ValLabel.TextSize = 11
        ValLabel.TextXAlignment = Enum.TextXAlignment.Right
        ValLabel.Parent = SliderFrame

        local BarBack = Instance.new("Frame")
        BarBack.Size = UDim2.new(1, -20, 0, 8)
        BarBack.Position = UDim2.new(0, 10, 0, 28)
        BarBack.BackgroundColor3 = Color3.fromRGB(38, 44, 55)
        BarBack.BorderSizePixel = 0
        BarBack.Parent = SliderFrame

        local bc = Instance.new("UICorner")
        bc.CornerRadius = UDim.new(1, 0)
        bc.Parent = BarBack

        local Fill = Instance.new("Frame")
        Fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
        Fill.BackgroundColor3 = Color3.fromRGB(35, 110, 240)
        Fill.BorderSizePixel = 0
        Fill.Parent = BarBack

        local fc = Instance.new("UICorner")
        fc.CornerRadius = UDim.new(1, 0)
        fc.Parent = Fill

        local isDown = false
        local function update(input)
            local ratio = math.clamp((input.Position.X - BarBack.AbsolutePosition.X) / BarBack.AbsoluteSize.X, 0, 1)
            value = math.floor(min + (max - min) * ratio)
            Fill.Size = UDim2.new(ratio, 0, 1, 0)
            ValLabel.Text = tostring(value)
            pcall(callback, value)
        end

        BarBack.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDown = true
                update(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDown = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if isDown and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                update(input)
            end
        end)
    end

    function tabFunctions:CreateInput(name, placeholder, callback)
        local InputFrame = Instance.new("Frame")
        InputFrame.Size = UDim2.new(1, -6, 0, 36)
        InputFrame.BackgroundColor3 = Color3.fromRGB(22, 28, 38)
        InputFrame.BorderSizePixel = 0
        InputFrame.Parent = Page

        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 6)
        c.Parent = InputFrame

        local Title = Instance.new("TextLabel")
        Title.Size = UDim2.new(0.6, 0, 1, 0)
        Title.Position = UDim2.new(0, 10, 0, 0)
        Title.BackgroundTransparency = 1
        Title.Font = Enum.Font.GothamMedium
        Title.Text = name
        Title.TextColor3 = Color3.fromRGB(230, 230, 230)
        Title.TextSize = 11
        Title.TextXAlignment = Enum.TextXAlignment.Left
        Title.Parent = InputFrame

        local Box = Instance.new("TextBox")
        Box.Size = UDim2.new(0.35, 0, 0, 24)
        Box.Position = UDim2.new(0.63, 0, 0.5, -12)
        Box.BackgroundColor3 = Color3.fromRGB(30, 38, 50)
        Box.BorderSizePixel = 0
        Box.Font = Enum.Font.Gotham
        Box.PlaceholderText = placeholder or "พิมพ์..."
        Box.Text = ""
        Box.TextColor3 = Color3.fromRGB(255, 255, 255)
        Box.TextSize = 11
        Box.Parent = InputFrame

        local bc = Instance.new("UICorner")
        bc.CornerRadius = UDim.new(0, 4)
        bc.Parent = Box

        Box.FocusLost:Connect(function()
            pcall(callback, Box.Text)
        end)

        return Box
    end

    function tabFunctions:CreateColorGrid(title, colorTable, callback)
        local GridHolder = Instance.new("Frame")
        GridHolder.Size = UDim2.new(1, -6, 0, 96)
        GridHolder.BackgroundColor3 = Color3.fromRGB(22, 28, 38)
        GridHolder.BorderSizePixel = 0
        GridHolder.Parent = Page

        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 6)
        c.Parent = GridHolder

        local Title = Instance.new("TextLabel")
        Title.Size = UDim2.new(1, -12, 0, 22)
        Title.Position = UDim2.new(0, 10, 0, 4)
        Title.BackgroundTransparency = 1
        Title.Font = Enum.Font.GothamBold
        Title.Text = title
        Title.TextColor3 = Color3.fromRGB(230, 230, 230)
        Title.TextSize = 12
        Title.TextXAlignment = Enum.TextXAlignment.Left
        Title.Parent = GridHolder

        local ButtonContainer = Instance.new("Frame")
        ButtonContainer.Size = UDim2.new(1, -20, 0, 62)
        ButtonContainer.Position = UDim2.new(0, 10, 0, 28)
        ButtonContainer.BackgroundTransparency = 1
        ButtonContainer.Parent = GridHolder

        local UIGrid = Instance.new("UIGridLayout")
        UIGrid.CellSize = UDim2.new(0, 70, 0, 26)
        UIGrid.CellPadding = UDim2.new(0, 5, 0, 5)
        UIGrid.Parent = ButtonContainer

        for _, item in ipairs(colorTable) do
            local cBtn = Instance.new("TextButton")
            cBtn.BackgroundColor3 = Color3.fromRGB(30, 38, 50)
            cBtn.BorderSizePixel = 0
            cBtn.Font = Enum.Font.GothamMedium
            cBtn.Text = item.Name
            cBtn.TextColor3 = item.Color or Color3.fromRGB(255, 255, 255)
            cBtn.TextSize = 11
            cBtn.Parent = ButtonContainer

            local cCorner = Instance.new("UICorner")
            cCorner.CornerRadius = UDim.new(0, 4)
            cCorner.Parent = cBtn

            cBtn.MouseButton1Click:Connect(function()
                pcall(callback, item)
            end)
        end
    end

    return tabFunctions
end

