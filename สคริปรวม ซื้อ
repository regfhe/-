-- ค้นหาไอคอนตัวรันภายนอก TZX (เช่น ไอคอนนินจาที่อยู่บนหน้าจอ)
-- ไม่แตะ FloatingIcon ของ TZX ซึ่งเป็นไอคอนเปิดเมนูรูปเงิน
local function looksLikeRunnerObject(obj)
    if not obj or not obj:IsA("GuiObject") then return false end
    if obj:IsDescendantOf(ScreenGui) then return false end

    local n = string.lower(obj.Name or "")
    local runnerWords = {
        "ninja", "runner", "executor", "executoricon", "delta", "arceus",
        "fluxus", "codex", "hydrogen", "swift", "scriptware", "krnl",
        "solara", "exploit", "injector"
    }
    for _, word in ipairs(runnerWords) do
        if string.find(n, word, 1, true) then
            return true
        end
    end

    -- สำรองกรณีไอคอนไม่มีชื่อสื่อความหมาย:
    -- ไอคอนตัวรันในภาพตัวอย่างอยู่ด้านบนกึ่งกลางและมีขนาดเล็ก
    if (obj:IsA("ImageButton") or obj:IsA("ImageLabel")) and obj.Visible then
        local ok, pos, size = pcall(function()
            return obj.AbsolutePosition, obj.AbsoluteSize
        end)
        if ok and pos and size then
            local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
            local centerX = pos.X + size.X / 2
            local centerY = pos.Y + size.Y / 2
            local nearTopCenter = centerY <= 150 and math.abs(centerX - viewport.X / 2) <= viewport.X * 0.22
            local smallIcon = size.X <= 120 and size.Y <= 120 and size.X >= 24 and size.Y >= 24
            if nearTopCenter and smallIcon then
                return true
            end
        end
    end
    return false
end

local function setRunnerIconHidden(hidden)
    if hidden then
        for _, obj in ipairs(ParentGui:GetDescendants()) do
            if looksLikeRunnerObject(obj) then
                if hiddenRunnerObjects[obj] == nil then
                    hiddenRunnerObjects[obj] = obj.Visible
                end
                obj.Visible = false
            end
        end
    else
        for obj, wasVisible in pairs(hiddenRunnerObjects) do
            if obj and obj.Parent then
                obj.Visible = wasVisible
            end
            hiddenRunnerObjects[obj] = nil
        end
    end
end

