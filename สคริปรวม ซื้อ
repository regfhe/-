-- ระบบซ่อนเมนู / เปิดเมนูด้วยท่าทางหรือคีย์ลัด
---------------------------------------------------------
local activeTouches = {}

UserInputService.TouchStarted:Connect(function(input, gameProcessed)
    if not hideMenuMode or gameProcessed then return end

    activeTouches[input] = true

    local count = 0
    for _ in pairs(activeTouches) do
        count += 1
    end

    if count >= 4 then
        local now = os.clock()

        if now - lastFourFingerTap <= fourFingerTapWindow then
            MainFrame.Visible = true
            FloatingIcon.Visible = false
            ConfirmOverlay.Visible = false
            lastFourFingerTap = 0
        else
            lastFourFingerTap = now
        end
    end
end)

UserInputService.TouchEnded:Connect(function(input)
    activeTouches[input] = nil
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not hideMenuMode then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    -- เปิดเมนูด้วยตัวอักษรที่ผู้ใช้ตั้งไว้ และรอ 0.5 วินาที
    if input.KeyCode == pcOpenKeyCode then
        pcOpenToken += 1
        local myToken = pcOpenToken

        task.delay(0.5, function()
            if hideMenuMode and input.KeyCode == pcOpenKeyCode and myToken == pcOpenToken then
                MainFrame.Visible = true
                FloatingIcon.Visible = false
                ConfirmOverlay.Visible = false
            end
        end)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if input.KeyCode == pcOpenKeyCode then
        pcOpenToken += 1
    end
end)

