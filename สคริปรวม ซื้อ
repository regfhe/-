local pcKeyInput = SettingsTab:CreateInput("🔑 ตัวอักษรเปิดเมนู (1 ตัว)", "เช่น Z", function(text)
    -- จำกัดให้เป็นตัวอักษรภาษาอังกฤษเพียง 1 ตัว
    local clean = string.upper(tostring(text or "")):match("%a")
    if clean and #clean == 1 then
        pcOpenKey = clean
        local keyCode = Enum.KeyCode[clean]
        if keyCode then
            pcOpenKeyCode = keyCode
        end
        pcKeyInput.Text = clean
    else
        pcKeyInput.Text = pcOpenKey
    end
end)
pcKeyInput.Text = pcOpenKey
pcKeyInput.ClearTextOnFocus = false

pcKeyInput:GetPropertyChangedSignal("Text"):Connect(function()
    local text = pcKeyInput.Text or ""
    if #text > 1 then
        pcKeyInput.Text = string.sub(text, 1, 1)
    end
end)

SettingsTab:CreateButton("✅ ยืนยันตัวอักษรเปิดเมนู", function()
    local text = string.upper(tostring(pcKeyInput.Text or ""))
    if text:match("^[A-Z]$") then
        pcOpenKey = text
        local keyCode = Enum.KeyCode[text]
        if keyCode then
            pcOpenKeyCode = keyCode
            pcOpenToken += 1
        end
        pcKeyInput.Text = pcOpenKey
    else
        pcKeyInput.Text = pcOpenKey
    end
end)

