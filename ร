-- ฟังก์ชันหาตำแหน่งรถหรือตัวละคร
local function GetRootPart()
    local char = LocalPlayer.Character
    if not char then return nil end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.SeatPart then
        local vehicle = hum.SeatPart.Parent
        while vehicle and not vehicle:IsA("Model") do
            vehicle = vehicle.Parent
        end
        if vehicle then
            return vehicle.PrimaryPart or hum.SeatPart
        end
    end
    return char:FindFirstChild("HumanoidRootPart")
end

-- ฟังก์ชันวาปไปยังตำแหน่งเป้าหมาย
local function TeleportTo(targetCFrame)
    local root = GetRootPart()
    if root and targetCFrame then
        root.CFrame = targetCFrame + Vector3.new(0, 3, 0)
    end
end

-- ฟังก์ชันกดปุ่ม UI ในโทรศัพท์อัตโนมัติ (แก้ปุ่ม Slide & Confirm)
local function ForceClickPhone()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end

    for _, v in pairs(playerGui:GetDescendants()) do
        if (v:IsA("TextButton") or v:IsA("ImageButton")) and v.Visible then
            local text = string.lower(v.Text or "")
            local name = string.lower(v.Name or "")
            
            -- ดักจับปุ่มรับงาน ปุ่มสไลด์ ปุ่มส่งงานในมือถือ
            if string.find(name, "accept") or string.find(text, "accept") or 
               string.find(name, "slide") or string.find(text, "slide") or
               string.find(name, "confirm") or string.find(text, "confirm") or
               string.find(text, "รับ") or string.find(text, "ส่ง") then
                
                pcall(function()
                    -- Trigger connection ทุกประเภทของปุ่ม
                    for _, eventName in pairs({"MouseButton1Click", "MouseButton1Down", "Activated", "TouchTap"}) do
                        if v[eventName] then
                            for _, conn in pairs(getconnections(v[eventName])) do
                                conn:Fire()
                            end
                        end
                    end
                end)
            end
        end
    end
end

-- ฟังก์ชันค้นหาตำแหน่งจุดรับ NPC / จุดส่งของใน Map
local function GetTargetDestination()
    -- 1. ตรวจหา Beam หรือ Highlight นำทางของเกม
    for _, obj in pairs(Workspace:GetDescendants()) do
        if (obj:IsA("Beam") or obj:IsA("SelectionBox") or obj:IsA("CylinderHandleAdornment")) then
            if obj.Visible and obj.Parent and obj.Parent:IsA("BasePart") then
                return obj.Parent.CFrame
            end
        end
    end
    
    -- 2. ตรวจหาป้ายหมุดลอย (BillboardGui / Waypoint Marker)
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BillboardGui") and obj.Enabled then
            if obj.Parent and obj.Parent:IsA("BasePart") then
                return obj.Parent.CFrame
            end
        end
    end
    
    -- 3. ตรวจหาจาก Model ลูกค้า NPC ใน Map
    for _, model in pairs(Workspace:GetChildren()) do
        if model:IsA("Model") and model:FindFirstChild("Humanoid") and model:FindFirstChild("Head") then
            if model.Head:FindFirstChildOfClass("BillboardGui") then
                return model.Head.CFrame
            end
        end
    end
    
    return nil
end

-- ลูปการทำงาน Auto Farm หลัก
task.spawn(function()
    while true do
        if AutoFarm then
            pcall(function()
                -- Step 1: กดรับงาน / กดปุ่มโทรศัพท์
                ForceClickPhone()
                
                -- Step 2: ค้นหาพิกัดและวาปรถ+ตัวละครไปหาจุดหมาย
                local targetCFrame = GetTargetDestination()
                if targetCFrame then
                    TeleportTo(targetCFrame)
                end
            end)
        end
        task.wait(0.5) -- ความถี่ในการทำงาน (0.5 วินาที)
    end
end)

