local function TriggerGrabEgg(targetPart)
    pcall(function()
        for _, desc in ipairs(workspace:GetDescendants()) do
            if desc:IsA("ProximityPrompt") and desc.Parent then
                local pPos = desc.Parent:IsA("BasePart") and desc.Parent.Position or (desc.Parent:IsA("Model") and desc.Parent:GetPivot().Position)
                if pPos and (pPos - targetPart.Position).Magnitude < 30 then
                    if fireproximityprompt then fireproximityprompt(desc) end
                    desc:InputHoldBegin()
                    task.wait(desc.HoldDuration > 0 and (desc.HoldDuration + 0.05) or 0.1)
                    desc:InputHoldEnd()
                end
            end
        end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp and firetouchinterest then
            firetouchinterest(hrp, targetPart, 0)
            task.wait(0.04)
            firetouchinterest(hrp, targetPart, 1)
        end

        if VirtualInputManager then
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(0.08)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end
    end)
end

local function ExecuteFarmMovement(targetPart, eggObj)
    if isMoving then return end
    isMoving = true

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChildOfClass("Humanoid") then
        isMoving = false
        return
    end

    local rootPart = char.HumanoidRootPart
    local humanoid = char:FindFirstChildOfClass("Humanoid")

    if not Settings.HomeCFrame then
        Settings.HomeCFrame = rootPart.CFrame
    end
    local homeCFrame = Settings.HomeCFrame
    local homePos = homeCFrame.Position

    -- 1. วาร์ปไปหาไข่ฟองนั้นทันที
    rootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
    rootPart.AssemblyLinearVelocity = Vector3.zero

    -- 2. รอก่อน 1 วินาทีเต็ม แล้วค่อยเก็บไข่ (ป้องกันระบบเกมขึ้นแจ้งเตือนว่าวาป)
    task.wait(1.0)
    TriggerGrabEgg(targetPart)
    task.wait(0.2)

    -- 3. เดินทางกลับตามโหมดที่เลือก (ไม่มีการวาร์ปกลับ)
    if Settings.FarmMode == "บิน" then
        -- โหมดบิน: บินกลับด้วยความเร็วที่ปลอดภัย (SafeFlySpeed = 150) ไม่โดนเตือนว่าวาป
        local flyNoclip = RunService.Stepped:Connect(function()
            if char and char.Parent then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end)

        local startCF = rootPart.CFrame
        local dist = (startCF.Position - homePos).Magnitude
        local duration = math.clamp(dist / Settings.SafeFlySpeed, 0.8, 14)
        local startT = tick()

        while tick() - startT < duration do
            if not (Settings.AutoFarmAll or Settings.AutoFarmRareOnly) and not isMoving then break end
            local alpha = (tick() - startT) / duration
            rootPart.CFrame = startCF:Lerp(homeCFrame, alpha)
            RunService.RenderStepped:Wait()
        end

        flyNoclip:Disconnect()
        rootPart.CFrame = homeCFrame
        rootPart.AssemblyLinearVelocity = Vector3.zero

    else
        -- โหมดวิ่ง: วิ่งกลับด้วยเท้าบนพื้นแท้จริง (Humanoid:MoveTo + WalkSpeed 250) ไม่บิน ไม่ใช้ CFrame Lerp
        local runNoclip = RunService.Stepped:Connect(function()
            if char and char.Parent then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end)

        humanoid.WalkSpeed = Settings.FarmRunSpeed -- ตั้งความเร็ววิ่ง 250
        local distToHome = (rootPart.Position - homePos).Magnitude
        local maxWaitHome = math.clamp(distToHome / 180 + 5, 6, 35)
        local startRet = tick()

        while (rootPart.Position - homePos).Magnitude > 5 do
            if not (Settings.AutoFarmAll or Settings.AutoFarmRareOnly) and not isMoving then break end
            if tick() - startRet > maxWaitHome then break end

            humanoid:MoveTo(homePos)
            task.wait(0.04)
        end

        runNoclip:Disconnect()
        rootPart.AssemblyLinearVelocity = Vector3.zero
        humanoid.WalkSpeed = Settings.WalkSpeed
    end

    isMoving = false
end

