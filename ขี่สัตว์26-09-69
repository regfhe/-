-- ==================== ระบบคัดกรองไข่ (ตัดไข่ในสวน / ตัด NPC / ตัดผู้เล่น) ====================
local function IsInGardenArea(obj)
    local parent = obj.Parent
    while parent and parent ~= workspace do
        local pName = string.lower(parent.Name)
        if string.find(pName, "garden") or string.find(pName, "plot") or string.find(pName, "base") or string.find(pName, "farm") or string.find(pName, "pen") or string.find(pName, "zone") then
            return true
        end
        parent = parent.Parent
    end
    return false
end

local function IsValidGroundEgg(obj)
    if not obj or not obj.Parent then return false end
    if not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end

    -- ตัดตัวผู้เล่นและ NPC
    if obj:FindFirstChildOfClass("Humanoid") or obj:FindFirstChild("HumanoidRootPart") then
        return false
    end

    -- ตัดไข่ที่วางไว้ในสวน/แปลงฟัก
    if IsInGardenArea(obj) then
        return false
    end

    local cur = obj
    while cur and cur ~= workspace do
        if cur:IsA("Tool") or cur:IsA("Backpack") or cur:FindFirstChildOfClass("Humanoid") then
            return false
        end
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character and (cur == p.Character or cur:IsDescendantOf(p.Character)) then
                return false
            end
        end
        cur = cur.Parent
    end

    local name = string.lower(obj.Name)
    local isEggName = string.find(name, "egg") or string.find(name, "ไข่")
    local hasPrompt = false

    for _, child in ipairs(obj:GetDescendants()) do
        if child:IsA("ProximityPrompt") then
            hasPrompt = true
            break
        end
    end

    return isEggName or hasPrompt
end

local function GetPrimaryPart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart end
        return obj:FindFirstChildWhichIsA("BasePart")
    end
    return nil
end

-- ==================== วิเคราะห์ความแรร์ตามรูปตัวอย่าง (500K ถึง 2.5T) ====================
local function AnalyzeExactEggTier(obj)
    local fullText = string.lower(obj.Name)
    for _, desc in ipairs(obj:GetDescendants()) do
        if desc:IsA("TextLabel") or desc:IsA("SurfaceGui") or desc:IsA("BillboardGui") then
            fullText = fullText .. " " .. string.lower(desc.Name)
            if desc:IsA("TextLabel") then
                fullText = fullText .. " " .. string.lower(desc.Text)
            end
        end
    end

    for _, tier in ipairs(ExactRareTiers) do
        if string.find(fullText, tier.pattern) then
            return tier.score, true, tier.label
        end
    end

    return 1, false, "NORMAL"
end

