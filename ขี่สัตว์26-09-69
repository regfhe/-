-- ==================== Heartbeat Loop ====================
local heartbeatConn = RunService.Heartbeat:Connect(function()
    pcall(function()
        local rainbow = Color3.fromHSV(tick() % 4 / 4, 1, 1)
        if Settings.UIBorderColor == "รุ้ง" then
            MainStroke.Color = rainbow
            IconStroke.Color = rainbow
        end

        local chosenESPColor = rainbow
        if Settings.ESPColorMode == "แดง" then
            chosenESPColor = Color3.fromRGB(255, 45, 45)
        elseif Settings.ESPColorMode == "น้ำเงิน" then
            chosenESPColor = Color3.fromRGB(0, 162, 255)
        end

        local char = LocalPlayer.Character
        local rootPart = char and char:FindFirstChild("HumanoidRootPart")

        -- 1. Auto Farm All
        if Settings.AutoFarmAll and not isFarming and not isMoving then
            isFarming = true
            task.spawn(function()
                while Settings.AutoFarmAll do
                    local bestTarget = nil
                    local bestEggObj = nil
                    local highestScore = -1

                    for obj, data in pairs(TrackedEggs) do
                        if obj and obj.Parent and IsValidGroundEgg(obj) and data.TargetPart and data.TargetPart.Parent then
                            if data.Score > highestScore then
                                highestScore = data.Score
                                bestTarget = data.TargetPart
                                bestEggObj = obj
                            end
                        else
                            CleanEggESP(obj)
                        end
                    end

                    if bestTarget and Settings.AutoFarmAll then
                        ExecuteFarmMovement(bestTarget, bestEggObj)
                        task.wait(0.2)
                    else
                        task.wait(0.8)
                    end
                end
                isFarming = false
            end)
        end

        -- 2. Auto Farm Rare Only (เฉพาะไข่แรร์ในรูป: 500K ถึง 2.5T)
        if Settings.AutoFarmRareOnly and not isFarming and not isMoving then
            isFarming = true
            task.spawn(function()
                while Settings.AutoFarmRareOnly do
                    local bestTarget = nil
                    local bestEggObj = nil
                    local highestScore = 499999 -- ต้องเป็นระดับ 500K ขึ้นไปเท่านั้น

                    for obj, data in pairs(TrackedEggs) do
                        if obj and obj.Parent and IsValidGroundEgg(obj) and data.TargetPart and data.TargetPart.Parent then
                            if data.IsRare and data.Score > highestScore then
                                highestScore = data.Score
                                bestTarget = data.TargetPart
                                bestEggObj = obj
                            end
                        else
                            CleanEggESP(obj)
                        end
                    end

                    if bestTarget and Settings.AutoFarmRareOnly then
                        ExecuteFarmMovement(bestTarget, bestEggObj)
                        task.wait(0.2)
                    else
                        task.wait(0.8)
                    end
                end
                isFarming = false
            end)
        end

        -- 3. Auto Place & Hatch
        if Settings.AutoPlaceEggs then
            pcall(function()
                local backpack = LocalPlayer:FindFirstChild("Backpack")
                local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                if backpack and humanoid then
                    for _, item in ipairs(backpack:GetChildren()) do
                        if item:IsA("Tool") and (string.find(string.lower(item.Name), "egg") or string.find(string.lower(item.Name), "ไข่")) then
                            humanoid:EquipTool(item)
                            task.wait(0.05)
                            break
                        end
                    end
                end
                for _, prompt in ipairs(workspace:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        local pText = string.lower(prompt.ActionText .. " " .. prompt.ObjectText .. " " .. prompt.Name)
                        if string.find(pText, "place") or string.find(pText, "วาง") or string.find(pText, "garden") then
                            if fireproximityprompt then fireproximityprompt(prompt) end
                        end
                    end
                end
            end)
        end

        if Settings.AutoHatchEggs then
            pcall(function()
                for _, prompt in ipairs(workspace:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        local pText = string.lower(prompt.ActionText .. " " .. prompt.ObjectText .. " " .. prompt.Name)
                        if string.find(pText, "hatch") or string.find(pText, "ฟัก") then
                            if fireproximityprompt then fireproximityprompt(prompt) end
                        end
                    end
                end
            end)
        end

        -- 4. ESP Update
        for obj, data in pairs(TrackedEggs) do
            if not obj or not obj.Parent or not IsValidGroundEgg(obj) or not data.TargetPart or not data.TargetPart.Parent then
                CleanEggESP(obj)
            else
                local shouldShow = Settings.ESPEnabled
                if Settings.RareOnly and not data.IsRare then
                    shouldShow = false
                end

                data.Highlight.Enabled = shouldShow
                data.Billboard.Enabled = shouldShow

                if shouldShow then
                    data.Highlight.OutlineColor = chosenESPColor
                    data.Highlight.FillColor = chosenESPColor

                    local dist = 0
                    if rootPart then
                        dist = math.floor((rootPart.Position - data.TargetPart.Position).Magnitude)
                    end

                    local displayText = ""
                    if Settings.ShowName then
                        displayText = (data.IsRare and "🍀 [" .. data.Tag .. "] " or "") .. obj.Name
                    end

                    if Settings.ShowDistance then
                        if displayText ~= "" then
                            displayText = displayText .. " \n[" .. tostring(dist) .. "m]"
                        else
                            displayText = "[" .. tostring(dist) .. "m]"
                        end
                    end

                    data.TextLabel.Text = displayText
                    data.TextLabel.TextColor3 = chosenESPColor
                end
            end
        end
    end)
end)

-- Cleanup
if getgenv then
    getgenv().TANG_ZX_HUB_CLEANUP = function()
        if addedConn then addedConn:Disconnect() end
        if removingConn then removingConn:Disconnect() end
        if heartbeatConn then heartbeatConn:Disconnect() end
        if globalNoclipConn then globalNoclipConn:Disconnect() end
        StopMovingImmediately()
        for obj, _ in pairs(TrackedEggs) do CleanEggESP(obj) end
        if ScreenGui then ScreenGui:Destroy() end
    end
end
