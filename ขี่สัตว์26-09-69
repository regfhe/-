local function GetColorFromTheme(themeName)
    if themeName == "รุ้ง" then
        return Color3.fromHSV(tick() % 4 / 4, 1, 1)
    elseif themeName == "แดง" then
        return Color3.fromRGB(255, 45, 45)
    elseif themeName == "ฟ้า" then
        return Color3.fromRGB(0, 162, 255)
    elseif themeName == "เขียว" then
        return Color3.fromRGB(46, 204, 113)
    elseif themeName == "ส้ม" then
        return Color3.fromRGB(243, 156, 18)
    elseif themeName == "ม่วง" then
        return Color3.fromRGB(155, 89, 182)
    elseif themeName == "ขาว" then
        return Color3.fromRGB(255, 255, 255)
    end
    return Color3.fromRGB(0, 162, 255)
end

